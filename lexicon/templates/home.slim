/ The view shown when no term is selected: title, tally, what was read, the index,
/ and what needs attention (unresolved references, approximate ones, parser notes).
section.view.home
  header.masthead
    .kicker
      span = kicker
      span = "built #{built}"
    h1 = config["title"]
    - if config["lede"]
      p.lede = config["lede"]
    - extras = book.collections.reject(&:primary)
    - unless extras.empty?
      .also
        p.also-head Also read into this page, as if they were in def/:
        ul
          - extras.each do |c|
            li
              code = c.rel
              - if c.title
                span.also-title = c.title
              - if c.note
                span.aside == mdi(c.note)
    - c = book.counts
    ul.tally
      li
        b = c[:terms]
        |  terms
      li
        b = c[:groups]
        |  term groups
      - unless book.extras.empty?
        li
          b = book.extras.size
          |  other views
      - c[:status].each do |status, n|
        li
          b = n
          |  #{status}

  section.index
    .letters
      - book.index_entries.each do |letter, entries|
        .letter
          h3 = letter
          ul
            - entries.each do |e|
              li class=e[:kind]
                - if e[:kind]
                  span.word = e[:word]
                  span.see
                    = e[:kind] == "avoid" ? (e[:word] == e[:term].local ? " unprefixed: avoid; see " : " avoid; see ") : " see "
                  a href="##{e[:term].anchor}" = book.display_name(e[:term])
                - else
                  a href="##{e[:term].anchor}" == headword_html(e[:term])
                  span.ns-tag = e[:term].ns

  - unless book.unresolved.empty?
    section.attention
      h2 Unresolved references
      p These @{…} references name no term on this page.
      ul
        - book.unresolved.each do |id, owners|
          li
            code = "@{#{id}}"
            |  in
            - owners.each_with_index do |o, i|
              = i.zero? ? " " : ", "
              - if o.is_a?(Lexicon::Term)
                a href="##{o.anchor}" = book.display_name(o)
              - else
                a href="##{o.id}" = o.label

  - unless book.approx.empty?
    section.attention
      h2 Approximate references
      p These link to the nearest term, which is not exactly the one named.
      ul
        - book.approx.each do |id, uses|
          - uses.each do |o, _how, detail|
            li
              code = "@{#{id}}"
              |  in
              - if o.is_a?(Lexicon::Term)
                a<> href="##{o.anchor}" = o.headword
              - else
                a<> href="##{o.id}" = o.label
              span.aside = detail

  - unless book.notes.empty?
    details.attention.parser-notes
      summary
        | Reading notes (#{book.notes.size})
      p What the builder read differently from plain udon, carried as written, or found inconsistent. Nothing listed here was dropped.
      ul
        - book.notes.each do |n|
          li
            code = "#{rel_path(n.file)}:#{n.line}"
            |  #{n.message}

  footer.colophon
    p
      | Generated by
      code< lexicon/build
      |  from
      - book.collections.each_with_index do |c, i|
        = i.zero? ? " " : ", "
        code = c.rel
      |  (#{book.views.map(&:file).uniq.size} files).
