/ The view shown when no term is selected: title, tally, and the index.
section.view.home
  header.masthead
    .kicker
      span = config["kicker"]
      span = "built #{built}"
    h1 = config["title"]
    - if config["lede"]
      p.lede = config["lede"]
    - c = book.counts
    ul.tally
      li
        b = c[:terms]
        |  terms
      li
        b = c[:groups]
        |  term groups
      - c[:status].each do |status, n|
        li
          b = n
          |  #{status}

  section.index
    .letters
      - book.index_entries.each do |letter, entries|
        .letter
          h3 = letter
          ul
            - entries.each do |e|
              li class=e[:kind]
                - if e[:kind]
                  span.word = e[:word]
                  span.see
                    = e[:kind] == "avoid" ? (e[:word] == e[:term].local ? " unprefixed: avoid; see " : " avoid; see ") : " see "
                  a href="##{anchor(e[:term].id)}" = e[:term].headword
                - else
                  a href="##{anchor(e[:term].id)}" = e[:word]
                  span.ns-tag = e[:term].ns

  - unless book.unresolved.empty?
    section.unresolved
      h2 Unresolved references
      p These @{…} references name no term in this lexicon.
      ul
        - book.unresolved.each do |id, owners|
          li
            code = "@{#{id}}"
            |  in
            - owners.each_with_index do |o, i|
              = i.zero? ? " " : ", "
              - if o.is_a?(Lexicon::Term)
                a href="##{anchor(o.id)}" = o.headword
              - else
                a href="##{o.id}" = File.basename(o.file)

  footer.colophon
    p
      | Generated by
      code< lexicon/build.rb
      |  from
      - book.groups.each_with_index do |g, i|
        = i.zero? ? " " : ", "
        code = rel_path(g.file)
      | .
