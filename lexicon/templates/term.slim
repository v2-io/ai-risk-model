/ One term's card: headword, definition, where the definition comes from, the words it
/ goes by or avoids, its other attributes, its relations, its blocks, and what points to it.
article.card.term id=t.anchor data-words=([t.headword, t.id].join(" ").downcase)
  header.term-head
    h2.headword
      == headword_html(t)
      - if t.scope
        span.hw-scope title="#{t.ns}: a scope the source mints this word in" = t.scope
    code.term-id = t.id
    - t.aliases.each do |al|
      code.term-id.alias title="also identified as" = al
    - if t.status && t.status != t.group.status
      span.status class=t.status = t.status
    - unless t.node.traits.empty? && t.node.flags.empty?
      span.traits = [*t.node.traits.map { |x| ".#{x}" }, *t.node.flags].join(" ")
  - unless t.definition.empty?
    p.definition == mdi(t.definition, group: t.group)
  - if t.node.comment
    p.block-note == mdi(t.node.comment)
  - unless t.body.empty?
    .block.plain.term-body
      .block-body == md(t.body, group: t.group)

  - src = source(t.attr("source"))
  - syn = Array(t.attr("synonyms")&.value)
  - avoid = t.attr("avoid")
  - extra = t.extra_attrs(config["term_attrs"])
  - if src || syn.any? || avoid || extra.any?
    dl.facts
      - if src
        .fact
          dt Source
          dd
            span.source-kind class=src.kind = src.kind
            span == mdi(src.text)
            - if src.note && !src.note.empty?
              span.source-note == mdi(src.note)
      - if syn.any?
        .fact
          dt Also
          dd
            - syn.each_with_index do |w, i|
              = i.zero? ? "" : ", "
              em = w
            - if t.attr("synonyms").comment
              span.aside == mdi(t.attr("synonyms").comment)
      - if avoid
        .fact
          dt Avoid
          dd
            - Array(avoid.value).each_with_index do |w, i|
              = i.zero? ? "" : ", "
              s = w
            - if avoid.comment
              span.aside == mdi(avoid.comment)
      - extra.each do |a|
        .fact
          dt = a.key
          dd
            span == attr_html(a)
            - if a.comment
              span.aside == mdi(a.comment)

  - rows = rel_rows(t.rels)
  - unless rows.empty?
    .rels
      .label Relations
      .rels-scroll
        table
          - rows.each do |_line, kind, x|
            - if kind == :rel
              - target, card = rel_value(x.raw)
              tr
                th class=(x.braced ? "amb-key" : nil) == rel_key(x)
                td.targets
                  == target
                  - if x.comment
                    span.rel-aside == mdi(x.comment)
                td.cardinality = card
            - elsif kind == :note
              tr.rel-note
                td colspan="3" == mdi(x)
            - else
              tr.rel-note
                td colspan="3"
                  == partial("block", b: x, group: t.group, scope: "term")

  - ordered(t.blocks).each do |b|
    == partial("block", b: b, group: t.group, scope: "term")

  - unless t.trailing.empty?
    .block.plain.term-body
      .block-body == md(t.trailing, group: t.group)

  - back = book.refs[t.id]
  - unless back.empty?
    footer.backlinks
      span.label Referenced by
      - back.each_with_index do |o, i|
        = i.zero? ? " " : ", "
        - if o.is_a?(Lexicon::Term)
          a href="##{o.anchor}" = book.display_name(o)
        - elsif o.kind == :group
          a href="##{o.id}" = "#{o.label} notes"
        - else
          a href="##{o.id}" = o.title
