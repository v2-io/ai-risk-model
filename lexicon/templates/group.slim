/ A term group's view: a quiet header (namespace, file, the comments above it in the
/ file, the text that introduces its terms), one card per term, then a card for the
/ group's own blocks (discussion, examples, working notes), then the way on.
section.view.group-view class=[family, (g.collection.primary ? nil : "from-elsewhere")] id=g.id
  header.group-head
    == partial("crumbs", v: g, ns: g.ns_root)
    == partial("lead", lead: g.lead)
    h2.group-name
      - g.terms.each_with_index do |t, i|
        = i.zero? ? "" : " · "
        a href="##{t.anchor}"
          == headword_html(t)
          - if t.scope
            span.hw-scope = t.scope
    - unless g.intro.empty?
      .intro == md(g.intro, group: g)

  .cards
    - g.terms.each do |t|
      == partial("term", t: t)

    - unless g.blocks.empty? && g.group_source.nil? && g.extra_attrs.empty? && g.trailing.empty? && g.comments.empty?
      article.card.notes
        .label.notes-label Notes on this group
        - g.comments.each do |c|
          p.block-note == mdi(c)
        - unless g.extra_attrs.empty?
          == partial("facts", attrs: g.extra_attrs)
        - unless g.trailing.empty?
          .block.plain.group-text
            .block-body == md(g.trailing, group: g)
        - ordered(g.blocks).each do |b|
          == partial("block", b: b, group: g, scope: "group")
        - src = source(g.group_source)
        - if src
          p.group-source == mdi(src.text)

  == partial("pager", v: g)
