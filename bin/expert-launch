#!/usr/bin/env python3
"""Start a source expert (experts/README.md): fill in experts/BRIEF.md, launch a
background Claude Code session the way Joseph starts sessions, and add the expert
to experts/registry.yaml.

    bin/expert-launch KEY "TITLE" [--note "anything this expert should know"]
                      [--lineage KEY2 KEY3 …] [--coordinator NAME] [--dry-run]

TITLE is how the brief names the source ("California SB 53, the Transparency in
Frontier Artificial Intelligence Act"). COORDINATOR is the Claude session the expert
reports to with SendMessage (default: ai-risk-search-tool). --dry-run prints the
brief and the command, and starts nothing.

The session is named expert-KEY. `claude --bg` picks its own session id (it ignores
--session-id), so the id recorded is the one `claude agents --json` reports. The
expert then asks whether it is willing and waits for Joseph; nothing is read until
he has talked with it.
"""
import argparse, datetime, json, os, subprocess, sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
PROMPT = os.path.expanduser('~/src/arch/proprium/comproprium/stopgap-system-prompt.md')
REGISTRY = os.path.join(ROOT, 'experts', 'registry.yaml')


def main():
    ap = argparse.ArgumentParser(description=__doc__.split('\n')[0], epilog=__doc__.split('\n', 1)[1],
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument('key')
    ap.add_argument('title')
    ap.add_argument('--note', default='')
    ap.add_argument('--lineage', nargs='*', default=[])
    ap.add_argument('--coordinator', default='ai-risk-search-tool')
    ap.add_argument('--dry-run', action='store_true')
    ap.add_argument('--model', help="Claude Code's --model (an alias such as 'sonnet', or a full name)")
    ap.add_argument('--suffix', default='', help='added to the session name, for a second expert on one source')
    a = ap.parse_args()
    if not os.path.isfile(os.path.join(ROOT, 'ref', 'canonical', a.key + '.md')):
        sys.exit(f'no canonical text for {a.key!r}; bin/canonicalize builds ref/canonical/{a.key}.md')
    name = 'expert-' + a.key + (('-' + a.suffix) if a.suffix else '')
    if f'name: {name}\n' in open(REGISTRY).read():
        sys.exit(f'{name} is already in experts/registry.yaml')
    brief = open(os.path.join(ROOT, 'experts', 'BRIEF.md')).read().split('\n---\n', 1)[1].strip()
    brief = brief.replace('COORDINATOR', a.coordinator).replace('TITLE', a.title).replace('KEY', a.key)
    if a.suffix:
        brief += (f"\n\nSince another expert has worked on this source, please keep your files apart from its: run "
                  f"`bin/reading {a.key} next --expert {a.key}-{a.suffix}`, put your reflections in "
                  f"experts/{a.key}-{a.suffix}/reading/, and give any worktree or branch the -{a.suffix} suffix.")
    if a.note:
        brief += '\n\n' + a.note
    cmd = ['claude', '--bg', '--dangerously-skip-permissions', '--append-system-prompt-file', PROMPT, '-n', name] + \
          (['--model', a.model] if a.model else []) + [brief]
    if a.dry_run:
        print(brief, '\n\n', ' '.join(cmd[:-1]), '"<brief>"')
        return
    subprocess.run(cmd, cwd=ROOT, check=True)
    agents = json.loads(subprocess.run(['claude', 'agents', '--json'], capture_output=True, text=True, check=True).stdout)
    sid = next((x.get('sessionId') for x in agents if x.get('name') == name), None)
    lineage = [a.key] + [k for k in a.lineage if k != a.key]
    entry = f"""  - key: {a.key}
    lineage: [{', '.join(lineage)}]
    name: {name}
    session: {sid or 'unknown (see claude agents --json)'}
    model: {a.model or 'the default'}
    started: {datetime.date.today().isoformat()}
    started_by: {a.coordinator}, with bin/expert-launch and experts/BRIEF.md
    state: asked
    read: []
    checkpoints: []
    context_after_preparation: null
"""
    with open(REGISTRY, 'a') as f:
        f.write(entry)
    print(f'{name} started (session {sid}); recorded in experts/registry.yaml. '
          f'It will message {a.coordinator} and wait for Joseph: claude attach {(sid or "")[:8]}')


if __name__ == '__main__':
    main()
