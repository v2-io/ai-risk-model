#!/usr/bin/env python3
"""Build and keep up to date the source index: a database of the catalog's sources,
cut into passages, with the terms they define (search/DESIGN.md).

    bin/source-index                 reconcile the database with the inputs
    bin/source-index --dry-run       say what would change, and change nothing
    bin/source-index --rebuild       drop the derived tables and rebuild them (the
                                     embedding cache is kept)
    bin/source-index --show KEY      print KEY's passages and definitions as the
                                     chunker cuts them now, without the database
    bin/source-index --defs KEY      the same, definitions only

The inputs are source-catalog.md (which keys, and their status), bib/refs.bib
(titles and authors) and ref/canonical/ (the texts). The catalog, not the
directory, decides what is indexed. Running it twice changes nothing the second
time; after an input changes, only what changed is redone.

The database is AIRISK_SOURCES_DB, by default airisk_sources, on the local
Postgres; it is created if missing. Embeddings are not built yet (DESIGN §11, step 2).
"""
import argparse, os, sys

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), 'search'))
from srcsearch import CANON, chunk, db  # noqa: E402


def show(key, defs_only=False):
    path = os.path.join(CANON, key + '.md')
    if not os.path.exists(path):
        sys.exit(f'no canonical text: {path}')
    raw = open(path, encoding='utf-8').read()
    ps, hs = chunk.passages(raw)
    for p in ps:
        if defs_only and not p['defs']:
            continue
        pr = f', printed "{p["printed"]}"' if p['printed'] else ''
        span = f'p.{p["page"]}' + (f'–{p["page_last"]}' if p['page_last'] != p['page'] else '')
        print(f"#{p['ord']}  {span}{pr}  {p['section']}  {'+'.join(p['kinds'])}  {len(p['text'])} chars"
              f"{'  [not in pdf]' if p['not_in_pdf'] else ''}")
        if p['path']:
            print('    ' + ' › '.join(p['path']))
        for d in p['defs']:
            print(f"    DEFINES {d['term']!r} ({d['kind']}, {d['conf']:.2f}): {d['evidence']}")
        if not defs_only:
            print('    ' + p['text'].replace('\n', '\n    '))
        print()
    print(f'{key}: {len(ps)} passages, {sum(len(p["defs"]) for p in ps)} definitions, {len(hs)} headings')


def main():
    ap = argparse.ArgumentParser(description=__doc__.split('\n\n')[0], formatter_class=argparse.RawDescriptionHelpFormatter,
                                 epilog=__doc__.split('\n\n', 1)[1])
    ap.add_argument('--dry-run', '-n', action='store_true')
    ap.add_argument('--rebuild', action='store_true')
    ap.add_argument('--show', metavar='KEY')
    ap.add_argument('--defs', metavar='KEY')
    ap.add_argument('--db', default=db.DB)
    a = ap.parse_args()
    if a.show or a.defs:
        return show(a.show or a.defs, defs_only=bool(a.defs))
    with db.connect(a.db, create=not a.dry_run) as conn:
        msg = db.ensure_schema(conn, rebuild=a.rebuild and not a.dry_run)
        if msg:
            sys.exit(msg)
        counts, warnings = db.reconcile(conn, dry_run=a.dry_run)
    for w in warnings:
        print(f'warning: {w}', file=sys.stderr)
    print(('would change: ' if a.dry_run else '') +
          ', '.join(f'{k} {v}' for k, v in counts.items() if v or k in ('unchanged',)))


if __name__ == '__main__':
    main()
