#!/usr/bin/env python3
"""Search the catalog's sources (search/DESIGN.md §7). Build the index first with
bin/source-index.

    source-search [verb] [flags] 'query' [scope …]

The query is one argument, as for grep and rg: quote a phrase. What follows it says
what to search (default: everything indexed). See "source-search help scopes".

Verbs (default: hybrid):
  hybrid        ranked: semantic and lexical rankings fused by RRF, then the weights
                in search/weights.toml (definitions of the term first, contents pages
                and references down, superseded versions down, …)
  semantic      ranked by cosine similarity alone: no lexical ranking, no weights.
                --without-phrase drops passages using the query's words as a phrase,
                leaving those that say it in other words
  defs          every definition of a term, grouped by source, active versions first
  outline       each document's outline, with only the sections that matter to the
                query unfolded, down to line ranges to read: a map of where to look
                (search/DESIGN.md §12). --lines sets its budget (default 200)
  The concordance: every occurrence, counted by form, at four strictnesses
  lexical       the loosest: the words in order anywhere within one passage
  exact-phrase  the words in order and adjacent, whole words exactly as typed
  exact-words   each word exactly as typed, counted on its own
  exact-bytes   those characters exactly, spaces and case included
  help          this; "help VERB" for a verb's flags; "help scopes" for sets and fields

Matching, for every concordance verb but exact-bytes (DESIGN §7.1):
- a lowercase letter matches either case, an uppercase letter only itself: 'ai'
  finds "AI" and "ai", 'AI' only "AI" (letter by letter, unlike rg's smart-case);
- words have boundaries; a '*' removes the one on its side: 'hazard*', '*hazard';
- the words of a phrase may be separated by any spaces, line breaks, hyphens or
  punctuation ('loss of control' finds "loss-of-control");
- lexical lets each word run on a little: a final e may drop before i or e ('use'
  finds "using"), a final y may become ie ('policy' finds "policies"), then up to
  four more letters and a plural or possessive ('assess' finds "assessments", not
  "reassess"; 'define' doesn't find "definition"). Function words ('of', 'the')
  stay whole.
Each concordance reports what the next looser verb would add, so a narrow search
says what it left out. Its matches come tightest first.

Examples:
  source-search 'catastrophic risk'
  source-search defs hazard Au5
  source-search lexical 'loss of control' influence:anchor
  source-search exact-phrase 'AI Concierge' 'anthropic-*'
  source-search semantic --without-phrase 'loss of control'
  source-search outline 'loss of control' Au5 --lines 60

Every result carries an anchor: relata key, physical PDF page, printed page where
established, and the exact quote, shown «⟨like this⟩» (JSON keeps it a plain
string). Where the source's fidelity record says the canonical text's page can't be
trusted, the page is settled against the PDF by bin/check-quote, once: the verdict
is cached. An anchor whose page still can't be confirmed says so exactly ("page not
confirmed", "not in the PDF"); there is no need to open the PDF. --verify runs
every anchor through bin/check-quote.

Output is JSON when stdout is not a terminal (--text to override).
Exit status: 0 with results, 1 with none, 2 for a usage error, 3 if the search
itself failed or a scope matched nothing (nothing on stdout then).
"""
import argparse, json, os, subprocess, sys, textwrap

sys.dont_write_bytecode = True
REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(REPO, 'search'))
from srcsearch import anchor, concord, db, embed, match, outline, rank, scope  # noqa: E402
from srcsearch.text import words  # noqa: E402

VERBS = ('hybrid', 'semantic', 'defs', 'outline', 'lexical', 'exact-phrase', 'exact-words', 'exact-bytes', 'help')
RETIRED = {'--all': 'the verb "lexical" (or exact-phrase, exact-words, exact-bytes)',
           '--defs': 'the verb "defs"', '--in': 'naming keys, sets or field:value after the query'}


def wrap(s, indent='    ', width=100):
    return textwrap.fill(s, width=width, initial_indent=indent, subsequent_indent=indent)


def short_path(path, width=130):
    """A heading path, its outer headings elided if it is too long."""
    parts = list(path)
    while len(parts) > 1 and len(' › '.join(parts)) > width:
        parts.pop(0)
    s = ' › '.join(parts)
    return ('… › ' if len(parts) < len(path) else '') + (s if len(s) <= width else s[:width - 1] + '…')


CONN = None      # the open connection, for settling anchors' pages from the cache


def verify(anchors, every=False):
    """Settle the pages of anchors that need the PDF (every anchor with --verify),
    by bin/check-quote, once per anchor: verdicts are cached (anchor.settle)."""
    n = anchor.settle(CONN, anchors, every=every)
    if n > 20:
        print(f'note: checked {n} quotes against the PDF; next time they come from the cache', file=sys.stderr)


# --------------------------------------------------------------------- ranked
def result_rows(res, pq, a):
    out = []
    for r, score, ex in res:
        (pid, key, ord_, start, end, page, printed, page_last, section, path, text, norm_sha, nip, status, influence,
         title, code, fidelity, ptc, active) = r
        dm = ex.get('defines')
        at = dm['at'] if dm else None
        an = anchor.make(key, start, end, pq['words'], at=at, fidelity=fidelity, pages_to_check=ptc)
        out.append(dict(rank=len(out) + 1, score=round(score, 6), anchor=an, title=title, code=code, status=status,
                        active_key=active, section=section, path=path, passage=f'{key}#{ord_}',
                        pages=[page, page_last], defines=dm,
                        copies=[dict(key=k, page=p) for k, p in ex.get('copies', [])],
                        matches=sorted({w for w in words(text) if any(w == q or len(q) >= 4 and q in w for q in pq['words'])}),
                        text=text if a.full else None, explain=ex if a.explain else None))
    verify([o['anchor'] for o in out], a.verify)
    return out


def query_vector(conn, a, required):
    if rank.has_vectors(conn, a.model):
        return embed.embed_query(a.model, rank.parse(a.query)['query'])
    if required:
        raise SystemExit(f'no {a.model} vectors yet: run bin/source-index')
    print(f'note: no {a.model} vectors yet, so lexical ranking only (run bin/source-index)', file=sys.stderr)
    return None


def hybrid(conn, a, keys):
    qvec = None if a.fusion == 'lexical' else query_vector(conn, a, required=a.fusion == 'semantic')
    res, pq = rank.search(conn, a.query, n=a.n, model=a.model, fusion=a.fusion, keys=keys, qvec=qvec)
    return result_rows(res, pq, a), pq


def semantic(conn, a, keys):
    qvec = query_vector(conn, a, required=True)
    exclude = None
    if a.without_phrase:
        exclude = lambda r: bool(match.finditer(a.query, 'loose-phrase', r[10]))  # noqa: E731
    res, pq = rank.semantic_search(conn, a.query, qvec, n=a.n, model=a.model, keys=keys, exclude=exclude)
    pq['without_phrase'] = a.query if a.without_phrase else None
    return result_rows(res, pq, a), pq


def print_ranked(out, pq, a):
    if pq.get('without_phrase'):
        print(f"(passages using {pq['without_phrase']!r} as a phrase left out)\n")
    for o in out:
        an = o['anchor']
        print(f"{o['rank']:>2}. {anchor.fmt(an)}")
        bits = [o['code'] or o['title'] or '']
        if o['status'] != 'active':
            bits.append(f"{o['status']}, active version {o['active_key']}" if o['active_key'] else o['status'])
        if o['defines']:
            d = o['defines']
            bits.append(f"defines {d['term']!r} ({d['kind']}, {d['conf']:.2f})")
        if o['section'] != 'body':
            bits.append(o['section'])
        print('    ' + ' · '.join(b for b in bits if b))
        if o['path']:
            print('    ' + short_path(o['path']))
        if o['copies']:
            print('    also verbatim in: ' + ', '.join(f"{c['key']} p.{c['page']}" for c in o['copies']))
        if o['matches']:
            print('    matches: ' + ', '.join(o['matches']))
        if a.full:
            print(wrap(o['text']))
        if a.explain:
            ex = o['explain']
            if 'base' in ex:
                sig = ''
                if ex.get('f_signals', 1.0) != 1.0:
                    pr = ex.get('proximity')
                    sig = (f" × signals {ex['f_signals']} (proximity {'none' if pr is None else f'{pr:.2f}'}, "
                           f"density {ex.get('density', 0):.2f})")
                print(f"    score {o['score']:.5f} = base {ex['base']:.5f} (semantic rank {ex['sem_rank']}, lexical rank "
                      f"{ex['lex_rank']}{', phrase' if ex['phrase'] else ''}{', heading' if ex['heading'] else ''})"
                      f" × defines {ex['f_def']:.2f} × section {ex['f_section']} × status {ex['f_status']}"
                      f" × influence {ex['f_influence']} × recency {ex['f_recency']}{sig}")
            else:
                print(f"    score {o['score']:.5f} = 1 − cosine distance {ex['distance']:.5f}")
        print()


# ---------------------------------------------------------------- definitions
def defs(conn, a, keys):
    groups, pq = rank.definitions(conn, a.query, keys=keys, narrower=not a.exact)
    out = []
    for key, rows in groups:
        r0 = rows[0]
        g = dict(key=key, title=r0[13], code=r0[14], status=r0[11], active_key=r0[18], influence=r0[12], definitions=[])
        for (k, term, norm, kind, conf, ev, at, page, printed, start, end, *_rest) in rows:
            an = anchor.make(k, start, end, pq['words'], at=at, fidelity=r0[16], pages_to_check=r0[17])
            g['definitions'].append(dict(term=term, kind=kind, conf=conf, evidence=ev, exact=norm == pq['norm'], anchor=an))
        out.append(g)
    verify([d['anchor'] for g in out for d in g['definitions']], a.verify)
    return out, pq


def print_defs(out, pq, a):
    n = sum(len(g['definitions']) for g in out)
    also = '' if a.exact else ' (and of terms containing it)'
    print(f'{n} definitions of "{pq["term"]}"{also} in {len(out)} documents\n')
    for g in out:
        st = '' if g['status'] == 'active' else f"  [{g['status']}" + (f", active version {g['active_key']}]" if g['active_key'] else ']')
        print(f"== {g['key']}  {g['code'] or ''}  {g['title'] or ''}{st}")
        for d in g['definitions']:
            print(f"  {d['term']!r}  ({d['kind']}, {d['conf']:.2f}{'' if d['exact'] else ', narrower term'})")
            print('    ' + anchor.fmt(d['anchor']))
        print()


# ---------------------------------------------------------------- concordance
def show(form, most=10):
    """A long span shortened for the terminal: its first and last words."""
    ws = form.split()
    return form if len(ws) <= most else f"{' '.join(ws[:4])} … {' '.join(ws[-3:])} ({len(ws)} words)"


def concordance(conn, a, keys):
    mode = concord.VERB_MODE[a.verb]
    try:
        match.pattern(a.query, mode)
    except ValueError as e:
        raise SystemExit(f'{a.verb}: {e}')
    occ, heads = concord.find(conn, a.query, mode, keys)
    more = concord.not_counted(conn, a.query, mode, keys, occ, heads)
    forms, docs = concord.counts(occ, heads)
    occ = concord.order(occ, docs)
    info = {r[0]: r[1:] for r in conn.execute(
        'select key, code, title, status, fidelity_mark, pages_to_check, influence from src.documents')}
    if not a.counts:
        concord.attach_anchors(occ, {k: (v[3], v[4]) for k, v in info.items()})
        verify([o['anchor'] for o in occ], a.verify)
    else:
        occ = []
    doc_rows = []
    for key in sorted(docs, key=lambda k: (-docs[k][0], -docs[k][1], k)):
        code, title, status, _fid, _ptc, influence = info.get(key, (None,) * 6)
        b, r, h = docs[key]
        doc_rows.append(dict(key=key, code=code, title=title, status=status, influence=influence,
                             body=b, references=r, headings=h))
    for o in occ:
        o.pop('start', None), o.pop('end', None)
    return dict(verb=a.verb, query=a.query, mode=mode, forms=forms, documents=doc_rows, occurrences=occ,
                headings=heads, not_counted=more)


def print_concordance(res, a):
    forms, docs = res['forms'], res['documents']
    tb, tr, th = (sum(v[i] for v in forms.values()) for i in range(3))
    kind = 'spans' if res['mode'] == 'loose' and len(match.terms(res['query'], 'loose')) > 1 else 'forms'
    print(f"{res['verb']} {res['query']!r}: {tb} in body text, {tr} in references, {th} in headings, "
          f"across {len(docs)} documents")
    if not forms:
        if res['not_counted'] and res['not_counted']['total']:
            w = res['not_counted']
            print(f"not counted: {w['verb']} {w['query']!r} would add {w['total']}: "
                  + ', '.join(f'{show(f)} {c}' for f, c in list(w['forms'].items())[:12]))
        return
    print(f'{kind} (body, references, headings):')
    for f, (b, r, h) in sorted(forms.items(), key=lambda x: (-sum(x[1]), len(x[0].split()), x[0]))[:a.forms]:
        print(f'  {b:>6} {r:>5} {h:>5}  {show(f)}')
    if len(forms) > a.forms:
        print(f'  … and {len(forms) - a.forms} more {kind} (--forms N shows more)')
    w = res['not_counted']
    if w and w['total']:
        shown = ', '.join(f'{show(f)} {c}' for f, c in list(w['forms'].items())[:12])
        rest = f', and {len(w["forms"]) - 12} more' if len(w['forms']) > 12 else ''
        print(f"not counted: {w['verb']} {w['query']!r} would add {w['total']}: {shown}{rest}")
    elif w:
        print(f"not counted: {w['verb']} {w['query']!r} would add nothing")
    print('\nby document:')
    for d in docs:
        st = '' if d['status'] == 'active' else f"  [{d['status']}]"
        print(f"  {d['key']:<52} {d['code'] or '':<10} body {d['body']}"
              + (f", references {d['references']}" if d['references'] else '')
              + (f", headings {d['headings']}" if d['headings'] else '') + st)
    if a.counts:
        return
    occ = res['occurrences']
    if a.by == 'source':
        print()
        cur = None
        for o in sorted(occ, key=lambda o: ([d['key'] for d in docs].index(o['key']), o['offset'])):
            if o['key'] != cur:
                cur = o['key']
                print(f'== {cur}')
            print(f"   {show(o['form']):<24} " + anchor.fmt(o['anchor']) + ('  (references)' if o['section'] == 'references' else ''))
        return
    print('\noccurrences, tightest first:' if kind == 'spans' else '\noccurrences:')
    for i, o in enumerate(occ, 1):
        prox = f'  [proximity {o["proximity"]:.2f}]' if kind == 'spans' and o['proximity'] < 1 else ''
        print(f"{i:>4}. {show(o['form'])}{prox}")
        print('      ' + anchor.fmt(o['anchor']) + ('  (references)' if o['section'] == 'references' else ''))


# ------------------------------------------------------------------- outline
def outline_verb(conn, a, keys):
    qvec = query_vector(conn, a, required=False)
    ans = rank.answerability(conn, a.query, qvec, model=a.model, keys=keys) if qvec is not None else None
    return outline.Outline(conn, a.query, keys=keys, qvec=qvec, model=a.model, budget=a.lines, answer=ans)


# ---------------------------------------------------------------------- help
def print_scopes(conn):
    d = scope.describe(conn)
    print(scope.__doc__)
    print('Sets (catalog/sets/):')
    for n, s in sorted(d['sets'].items()):
        size = f"{s['documents']} documents" if 'documents' in s else f"ERROR: {s['error']}"
        print(f"  {n:<14} {size:<14} {s['description']}")
    for f, vals in d['fields'].items():
        print(f'\n{f}:')
        for v, c in list(vals.items())[:20]:
            print(f'  {c:>4}  {v}')


def parsers():
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument('query', help='one argument; quote a phrase')
    common.add_argument('scope', nargs='*', help='relata keys, key globs, sets, field:value (default: everything)')
    common.add_argument('--verify', action='store_true',
                        help='run every anchor through bin/check-quote (anchors whose page needs the PDF always are)')
    fmt = common.add_mutually_exclusive_group()
    fmt.add_argument('--json', action='store_true')
    fmt.add_argument('--text', action='store_true', help='readable text even when stdout is not a terminal')
    common.add_argument('--db', default=db.DB, help=argparse.SUPPRESS)
    ranked = argparse.ArgumentParser(add_help=False)
    ranked.add_argument('-n', type=int, default=10, help='how many results (default 10)')
    ranked.add_argument('--full', action='store_true', help='print each passage whole')
    ranked.add_argument('--explain', action='store_true', help='the factors behind each score')
    ranked.add_argument('--model', default=embed.DEFAULT_MODEL, choices=sorted(embed.MODELS))
    conc = argparse.ArgumentParser(add_help=False)
    conc.add_argument('--counts', action='store_true', help='counts only, no occurrence lines')
    conc.add_argument('--forms', type=int, default=30, metavar='N', help='how many forms or spans to list (default 30)')
    conc.add_argument('--by', choices=('source',), help='group the occurrences by document')
    desc = dict(
        hybrid='Ranked: the semantic and lexical rankings fused by RRF, then the weights in search/weights.toml.',
        semantic='Ranked by cosine similarity alone, over the whole corpus, with none of the weights.',
        defs='Every definition of a term, grouped by source, active versions first.',
        outline='Each document\'s outline with only what matters to the query unfolded: sections fold to one '
                'line saying what they hold, and opened ranges (▸) give lines of ref/canonical/KEY.md to read and '
                'an anchor to cite. Scored by hybrid\'s ranking (search/DESIGN.md §12).',
        lexical='The loosest concordance: the words in order anywhere within one passage, each word able to run on '
                'a little (see source-search --help).',
        **{'exact-phrase': 'Concordance: the words in order and adjacent, whole words exactly as typed.',
           'exact-words': 'Concordance: each word exactly as typed, as a whole word, counted on its own.',
           'exact-bytes': 'Concordance: those characters exactly, spaces and case included, in the indexed text '
                          '(markup removed, runs of spaces made one).'})
    out = {}
    for v in VERBS[:-1]:
        parents = [common] + ([ranked] if v in ('hybrid', 'semantic') else []) + ([conc] if v in concord.VERB_MODE else [])
        p = argparse.ArgumentParser(prog=f'source-search {v}', description=desc[v], parents=parents)
        if v == 'hybrid':
            p.add_argument('--fusion', choices=('rrf', 'mix', 'lexical', 'semantic'), help=argparse.SUPPRESS)
        if v == 'semantic':
            p.add_argument('--without-phrase', action='store_true',
                           help='leave out passages using the query as a phrase (its words adjacent, each '
                                'allowed lexical\'s run-on): what remains says it in other words')
        if v == 'defs':
            p.add_argument('--exact', action='store_true', help='the term itself only, not terms containing it')
        if v == 'outline':
            p.add_argument('--lines', type=int, default=200, help='the line budget for the whole outline (default 200)')
            p.add_argument('--model', default=embed.DEFAULT_MODEL, choices=sorted(embed.MODELS))
        out[v] = p
    return out


def main():
    argv = sys.argv[1:]
    ps = parsers()
    if not argv or argv[0] in ('-h', '--help'):
        print(__doc__)
        sys.exit(0)
    for old, new in RETIRED.items():
        if old in argv:
            print(f'source-search: {old} is retired; use {new}. See source-search --help.', file=sys.stderr)
            sys.exit(2)
    verb = argv.pop(0) if argv[0] in VERBS else 'hybrid'
    if verb == 'help':
        topic = argv[0] if argv else None
        if topic in ps:
            ps[topic].print_help()
        elif topic == 'scopes':
            with db.connect(db.DB) as conn:
                print_scopes(conn)
        else:
            print(__doc__)
        sys.exit(0)
    a = ps[verb].parse_intermixed_args(argv)
    a.verb = verb
    as_json = a.json or (not a.text and not sys.stdout.isatty())
    try:
        with db.connect(a.db) as conn:
            global CONN
            CONN = conn
            keys = scope.resolve(conn, a.scope)
            if verb == 'defs':
                out, pq = defs(conn, a, keys)
                n = sum(len(g['definitions']) for g in out)
                payload = dict(verb=verb, query=pq['query'], term=pq['term'], results=out)
            elif verb == 'outline':
                o = outline_verb(conn, a, keys)
                n = len(o.tier)             # hits, opened or not: a budget too small to open any is not "no results"
                rows = o.render()
                verify([r['anchor'] for r in rows if r['kind'] == 'range'], a.verify)
                payload = dict(verb=verb, **o.as_json(rows)) if as_json else None
                text = None if as_json else o.text(rows)
            elif verb in concord.VERB_MODE:
                res = concordance(conn, a, keys)
                n = len(res['documents'])
                payload = res
            else:
                out, pq = hybrid(conn, a, keys) if verb == 'hybrid' else semantic(conn, a, keys)
                n = len(out)
                payload = dict(verb=verb, query=pq['query'], term=pq['term'], results=out)
            if keys is not None and payload is not None:
                payload['scope'] = dict(selectors=a.scope, keys=keys)
    except scope.ScopeError as e:
        print(f'source-search: {e}', file=sys.stderr)
        sys.exit(3)
    except SystemExit:
        raise
    except Exception as e:
        print(f'source-search failed: {type(e).__name__}: {e}', file=sys.stderr)
        sys.exit(3)
    if as_json:
        if verb in concord.VERB_MODE:
            payload = dict(payload, forms={f: dict(body=v[0], references=v[1], headings=v[2])
                                           for f, v in payload['forms'].items()})
        print(json.dumps(payload, ensure_ascii=False, indent=1, default=str))
    elif verb == 'outline':
        print(text)
    elif verb == 'defs':
        print_defs(out, pq, a)
    elif verb in concord.VERB_MODE:
        print_concordance(res, a)
    else:
        print_ranked(out, pq, a)
    if not n:
        print(f'no results for {a.query!r}', file=sys.stderr)
    sys.exit(0 if n else 1)


if __name__ == '__main__':
    main()
